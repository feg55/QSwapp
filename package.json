{
  "name": "layout-fixer-extension",
  "version": "3.2.0",
  "private": true,
  "description": "Offline correction for text typed with the wrong English or Russian keyboard layout",
  "scripts": {
    "dictionary:generate": "node scripts/generate-dictionaries.js",
    "dictionary:check": "node scripts/generate-dictionaries.js --check",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --test tests/e2e/*.e2e.js",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "playwright-core": "^1.62.0"
  }
}
